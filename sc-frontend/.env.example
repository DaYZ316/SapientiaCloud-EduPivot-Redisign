# Copy this file to sc-frontend/.env for local Vite development.
# VITE_* variables are bundled into browser code, so do not put secrets here.

# Empty means same-origin requests. In local dev, Vite proxies /api.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:39080
VITE_AI_PROXY_TARGET=http://localhost:28086

# OAuth public client settings
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/login
VITE_DESKTOP_GITHUB_REDIRECT_URI=https://edupivot.xyz/login
VITE_GITHUB_SCOPE=read:user user:email
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google
