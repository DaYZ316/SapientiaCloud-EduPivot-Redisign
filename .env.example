# Copy this file to .env before running Docker Compose.
# Do not put real secrets in this example file.

# Spring profile
SPRING_PROFILES_ACTIVE=docker

# PostgreSQL
POSTGRES_DB=edupivot
POSTGRES_USER=edupivot
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_PORT=5432
NACOS_POSTGRES_DB=nacos

# Redis Stack
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_PORT=6379
REDIS_MAXMEMORY=0
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_LATENCY_MONITOR_THRESHOLD=0

# Kafka
KAFKA_PORT=9092

# MinIO
MINIO_ROOT_USER=edupivot
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_CORS_ORIGINS=https://edupivot.xyz,edupivot://app,https://localhost
MINIO_DESKTOP_CORS_ORIGIN=edupivot://app
MINIO_MOBILE_CORS_ORIGIN=https://localhost

# Nacos
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_RAFT_PORT=9849
NACOS_CONSOLE_PORT=8080
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-strong-nacos-password
NACOS_AUTH_TOKEN=replace-with-at-least-32-byte-token
NACOS_AUTH_IDENTITY_KEY=replace-with-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-identity-value

# JWT RS256 keys. Generate values with docs/部署与安装说明书.md section 8.
JWT_PRIVATE_KEY_B64=replace-with-base64-private-key
JWT_PUBLIC_KEY_B64=replace-with-base64-public-key

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated exact callback allowlist. Do not include wildcard URLs.
GITHUB_REDIRECT_URIS=http://localhost:5173/oauth/github/callback,https://edupivot.xyz/oauth/github/callback,https://edupivot.xyz/oauth/github/mobile/callback
# Browser build value. This must be one member of GITHUB_REDIRECT_URIS.
GITHUB_WEB_REDIRECT_URI=http://localhost:5173/oauth/github/callback
GITHUB_SCOPE=read:user user:email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:18080/auth/callback/google

# Frontend build
# Leave empty for same-origin /api requests through Nginx or Vite proxy.
VITE_API_BASE_URL=

# Host binding and service ports
# Keep sensitive services bound to 127.0.0.1 unless a firewall limits access.
EDUPIVOT_BIND_HOST=127.0.0.1
EDUPIVOT_BACKEND_BIND_HOST=127.0.0.1
EDUPIVOT_FRONTEND_PORT=18080
EDUPIVOT_GATEWAY_PORT=39080
EDUPIVOT_AUTH_PORT=28081
EDUPIVOT_NOTIFICATION_PORT=28082
EDUPIVOT_COURSE_PORT=28084
EDUPIVOT_STORAGE_PORT=28085
EDUPIVOT_AI_PORT=28086

# Artifact deployment frontend ports and TLS cert mount
EDUPIVOT_HTTP_PORT=80
EDUPIVOT_HTTPS_PORT=443
EDUPIVOT_SSL_CERT_DIR=/etc/nginx/cert

# Docker images
MAVEN_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
RUNTIME_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
JAVA_RUNTIME_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
FRONTEND_NODE_IMAGE=node:22-alpine
FRONTEND_NGINX_IMAGE=nginx:1.27-alpine
SKYWALKING_AGENT_IMAGE=apache/skywalking-java-agent:9.6.0-java21

# AI and web search
DASHSCOPE_API_KEY=
AGENT_SEARCH_WEB_SEARCH_ENABLED=true
AGENT_SEARCH_WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
AGENT_SEARCH_WEB_SEARCH_API_KEY=
AGENT_SEARCH_WEB_SEARCH_MAX_RESULTS=5
AGENT_SEARCH_WEB_SEARCH_TIMEOUT=5s
AGENT_SEARCH_WEB_SEARCH_MAX_SNIPPET_CHARS=500

# LiveKit
LIVEKIT_URL=wss://your-domain.example/livekit
LIVEKIT_SERVER_URL=http://livekit:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_IMAGE=livekit/livekit-server:latest
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_API_BIND_HOST=127.0.0.1
LIVEKIT_RTC_BIND_HOST=0.0.0.0

# Observability
SKYWALKING_UI_PORT=18090
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

# JVM and service memory
EDUPIVOT_JAVA_OPTS_SMALL=-Xms128m -Xmx512m
EDUPIVOT_JAVA_OPTS_LARGE=-Xms256m -Xmx768m
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=768m
NACOS_JVM_XMN=256m
SKYWALKING_OAP_JAVA_OPTS=-Xms512m -Xmx1536m
