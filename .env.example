# ============================================================
# 智语·云枢 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ---- 部署模式 ----
SPRING_PROFILES_ACTIVE=docker

# ---- PostgreSQL ----
POSTGRES_DB=edupivot
POSTGRES_USER=edupivot
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_PORT=5432
NACOS_POSTGRES_DB=nacos

# ---- Redis ----
REDIS_PASSWORD=your-redis-password
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=edupivot
MINIO_ROOT_PASSWORD=your-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_CORS_ORIGIN=http://localhost:5173

# ---- Nacos ----
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_RAFT_PORT=9849
NACOS_CONSOLE_PORT=8081
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=change-me-to-a-very-long-nacos-auth-token-with-at-least-32-characters
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=sc-edupivot

# ---- JWT RS256 密钥 ----
# 使用 scripts/generate-rsa-keys.sh 生成
JWT_PRIVATE_KEY_B64=your-base64-encoded-private-key
JWT_PUBLIC_KEY_B64=your-base64-encoded-public-key

# ---- GitHub OAuth2 ----
# 前端和后端共用同一份配置，docker-compose 会自动映射 VITE_ 前缀给前端
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/login
GITHUB_SCOPE=read:user user:email

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# ---- 前端 API 地址 ----
VITE_API_BASE_URL=http://localhost:39080

# ---- Kafka ----
KAFKA_PORT=9092

# ---- Zipkin ----
ZIPKIN_PORT=9411

# ---- 服务端口 ----
EDUPIVOT_AUTH_PORT=28081
EDUPIVOT_NOTIFICATION_PORT=28082
EDUPIVOT_WEB_PORT=28083
EDUPIVOT_COURSE_PORT=28084
EDUPIVOT_STORAGE_PORT=28085
EDUPIVOT_GATEWAY_PORT=39080
EDUPIVOT_FRONTEND_PORT=5173

# ---- Docker 镜像 ----
MAVEN_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
RUNTIME_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
FRONTEND_NODE_IMAGE=node:22-alpine
FRONTEND_NGINX_IMAGE=nginx:1.27-alpine
STORAGE_MAVEN_IMAGE=maven:3.9-eclipse-temurin-21
STORAGE_RUNTIME_IMAGE=eclipse-temurin:21-jre
