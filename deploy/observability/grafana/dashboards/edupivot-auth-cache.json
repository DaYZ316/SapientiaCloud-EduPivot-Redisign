          "editorMode": "code",
          "expr": "(sum(rate(redis_auth_cache_read_total{job=\"sc-edupivot-backend\",instance=~\"${instance:regex}\",result=~\"hit|negative_hit\"}[5m])) or vector(0)) / clamp_min((sum(rate(redis_auth_cache_read_total{job=\"sc-edupivot-backend\",instance=~\"${instance:regex}\",result=~\"hit|negative_hit|miss\"}[5m])) or vector(0)), 1)",
